rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated users can access their own user directory and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Top-level journal sessions isolated strictly by authenticated uid
    match /journal_sessions/{sessionId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Top-level saved bureaucracy analyses isolated strictly by authenticated uid
    match /saved_analyses/{analysisId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
